    "affected:test": "nx affected --target=test",
    "affected:deploy": "nx affected --target=deploy"
  },
  "devDependencies": {
    "@azure/functions": "^4.11.2",
    "@google-cloud/functions-framework": "^5.0.0",
    "@nx/js": "latest",
    "@nx/workspace": "latest",
    "@types/aws-lambda": "^8.10.160",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.27.3",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "nx": "latest",
    "prettier": "^3.0.0",
    "serverless": "^4.0.0",
    "serverless-esbuild": "^1.57.0",
    "serverless-offline": "^14.4.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@10.2.1",
  "nx": {
    "includedProjects": [
      "domain",
      "application",
      "infrastructure"
    ]
  },
  "dependencies": {
    "tslib": "^2.8.1"
