{
  "name": "js-serverless-monorepo-boilerplate",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "nx run-many --target=build",
    "test": "nx run-many --target=test",
    "deploy:aws": "nx run-many --target=deploy --tags=provider:aws",
    "deploy:azure": "nx run-many --target=deploy --tags=provider:azure",
    "deploy:gcp": "nx run-many --target=deploy --tags=provider:gcp"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "aws-lambda": "^1.0.7",
    "nx": "latest",
    "plop": "^4.0.1"
  }
}