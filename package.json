{
  "name": "js-serverless-monorepo-boilerplate",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "nx": "nx",
    "lint": "nx run-many --target=lint",
    "test": "nx run-many --target=test",
    "build": "nx run-many --target=build",
