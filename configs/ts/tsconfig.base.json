{
    "compileOnSave": false,
    "compilerOptions": {
      "sourceMap": true,
      "composite": true,
      "declarationMap": true,
      "declaration": true, 
      "moduleResolution": "node",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "importHelpers": true,
      "target": "es2015",
      "module": "esnext",
      "lib": [
        "es2017",
        "dom"
      ],
      "skipLibCheck": true,
      "skipDefaultLibCheck": true,
      "baseUrl": ".",
      "paths": {
        "@org/utils": [
          "packages/utils/src/index.ts"
        ],
        "@org/types": [
          "packages/types/src/index.ts"
        ]
      }
    },
    "exclude": [
      "node_modules",
      "tmp"
    ]
  }