{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "workspaceLayout": {
      "appsDir": "apps",
      "libsDir": "libs"
    },
    "plugins": [
      {
        "plugin": "@nx/js/typescript",
        "options": {
          "typecheck": false
        }
      }
    ],
    "namedInputs": {
      "default": ["{projectRoot}/**/*", "sharedGlobals"],
      "sharedGlobals": []
    },
    "targetDefaults": {
      "build": {
        "dependsOn": ["^build"],
        "inputs": ["default", "^default"],
        "outputs": ["{projectRoot}/dist"],
        "cache": true
      },
      "lint": {
        "inputs": ["default"],
        "cache": true
      },
      "test": {
        "inputs": ["default", "^default"],
        "cache": true
      },
      "deploy": {
        "dependsOn": ["build", "test", "lint"],
        "cache": false
      }
    },
    "affected": {
      "defaultBase": "main"
    }
  }