# ----------------------------------------------------------------
# AWS CREDENTIALS & SETTINGS FOR LOCAL DEVELOPMENT
# ----------------------------------------------------------------
# This file is a template. To use it, create a copy named.env
# in the same directory and fill in your personal values.
# The.env file is ignored by Git and should NEVER be committed.
#
# AWS_PROFILE: The name of your AWS named profile from your
# local ~/.aws/credentials file. The Serverless Framework will use
# this profile to authenticate for deployments.
# ----------------------------------------------------------------

AWS_PROFILE=default

# ----------------------------------------------------------------
# DEFAULT DEPLOYMENT SETTINGS
# --------------------------------------------------------------
--------------------------------
# These variables set the default stage and region for local
# deployments. They can be overridden by command-line flags.
# ----------------------------------------------------------------

STAGE=dev
REGION=us-east-1

